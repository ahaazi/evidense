# Azure AI Foundry project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=
AGENT_NAME=
AGENT_VERSION=latest

# Service principal auth (optional — `az login` works too)
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=

# Set to 1 to preview the UI with a stored sample answer
DEMO_MODE=0
